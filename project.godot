config_version=5

[application]

config/name="HUNGER FOR WAR"
run/main_scene="res://scenes/main.tscn"

[autoload]

GameSession="*res://scripts/game/game_session.gd"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}

look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}

look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}

look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}

look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}

aim={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}


reload={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":2)]
}

jump={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":0)]
}

crouch={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":1)]
}

sprint={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":7)]
}

weapon_previous={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":9)]
}

weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":10)]
}

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.17, 1)
